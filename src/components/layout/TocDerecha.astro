---
interface Props {
  encabezados: Array<{ nivel: number; texto: string; id: string }>;
}

const { encabezados } = Astro.props;
---

<aside class="sticky top-20 hidden h-[calc(100vh-6rem)] overflow-y-auto lg:block no-print">
  <nav aria-label="Subíndice de la sección" class="border-l border-[hsl(var(--border))] pl-4 text-sm">
    <p class="mb-3 font-mono text-xs uppercase tracking-[0.16em] text-[hsl(var(--muted-foreground))]">En esta sección</p>
    <ol class="space-y-1">
      {encabezados.map((item) => (
        <li class={item.nivel === 4 ? "pl-3" : ""}>
          <a href={`#${item.id}`} data-toc-link={item.id} class="block rounded-md px-2 py-1 text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--muted))] hover:text-[hsl(var(--foreground))] hover:no-underline">
            {item.texto}
          </a>
        </li>
      ))}
    </ol>
  </nav>
</aside>

<script>
  const headings = Array.from(document.querySelectorAll<HTMLElement>("article h3[id], article h4[id]"));
  const links = new Map(Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-toc-link]")).map((link) => [link.dataset.tocLink, link]));
  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries.filter((entry) => entry.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
      if (!visible) return;
      links.forEach((link) => {
        link.classList.remove("bg-[hsl(var(--muted))]", "text-[hsl(var(--foreground))]");
      });
      const active = links.get((visible.target as HTMLElement).id);
      active?.classList.add("bg-[hsl(var(--muted))]", "text-[hsl(var(--foreground))]");
    },
    { rootMargin: "-20% 0px -70% 0px", threshold: 0.01 }
  );
  headings.forEach((heading) => observer.observe(heading));
</script>

