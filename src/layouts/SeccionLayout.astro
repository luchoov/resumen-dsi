---
import type { CollectionEntry } from "astro:content";
import BaseLayout from "./BaseLayout.astro";
import Topbar from "@/components/layout/Topbar.astro";
import SidebarIndice from "@/components/layout/SidebarIndice.astro";
import TocDerecha from "@/components/layout/TocDerecha.astro";
import Breadcrumb from "@/components/layout/Breadcrumb.astro";
import PrevNext from "@/components/layout/PrevNext.astro";
import type { Seccion } from "@/lib/secciones";
import { preguntasDeSeccion, bancoSeccionUrl } from "@/lib/banco";

interface Props {
  seccion: Seccion;
  secciones: Seccion[];
  encabezados: Array<{ nivel: number; texto: string; id: string }>;
  previa?: CollectionEntry<"secciones">;
  siguiente?: CollectionEntry<"secciones">;
  indiceBusqueda: Array<Record<string, string | number>>;
}

const { seccion, secciones, encabezados, previa, siguiente, indiceBusqueda } = Astro.props;
const cantPreguntas = preguntasDeSeccion(seccion.data.slug).length;
const bancoUrl = bancoSeccionUrl(seccion.data.slug);
---

<BaseLayout titulo={`${seccion.data.numero}. ${seccion.data.titulo} · Resumen DSI`} descripcion={seccion.data.resumen}>
  <Topbar indiceBusqueda={indiceBusqueda} />
  <div class="seccion-grid mx-auto grid w-full max-w-[96rem] grid-cols-1 gap-8 px-4 pb-14 pt-20 lg:grid-cols-[17rem_minmax(0,1fr)_15rem] lg:px-6">
    <SidebarIndice secciones={secciones} activa={seccion.data.slug} />
    <main id="contenido" class="min-w-0">
      <Breadcrumb items={[{ label: "Inicio", href: "/" }, { label: `Sección ${seccion.data.numero}` }, { label: seccion.data.titulo }]} />
      <article class="prose-dsi min-w-0">
        <header class="mb-10 border-b border-[hsl(var(--border))] pb-8">
          <p class="mb-3 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-[hsl(var(--primary))]">Sección {seccion.data.numero}</p>
          <h1 class="max-w-4xl text-[length:var(--text-fluid-3xl)] font-bold leading-[1.05] tracking-[-0.02em]">{seccion.data.titulo}</h1>
          <p class="mt-5 max-w-3xl text-[length:var(--text-fluid-lg)] text-[hsl(var(--muted-foreground))]">{seccion.data.resumen}</p>
        </header>
        <slot />
        {cantPreguntas > 0 && (
          <a
            href={bancoUrl}
            class="not-prose mt-12 flex items-center gap-4 rounded-2xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-5 transition-colors hover:border-[hsl(var(--primary)/0.5)] hover:bg-[hsl(var(--muted))]"
          >
            <span class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-[hsl(var(--primary)/0.12)] text-[hsl(var(--primary))]">
              <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3" /><path d="M12 17h.01" /><circle cx="12" cy="12" r="10" /></svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block font-semibold text-[hsl(var(--foreground))]">Autoevaluate</span>
              <span class="mt-0.5 block text-sm text-[hsl(var(--muted-foreground))]">
                {cantPreguntas} {cantPreguntas === 1 ? "pregunta" : "preguntas"} para chequear que entendiste esta sección.
              </span>
            </span>
            <svg class="h-5 w-5 shrink-0 text-[hsl(var(--muted-foreground))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
          </a>
        )}
      </article>
      <PrevNext previa={previa} siguiente={siguiente} />
    </main>
    <TocDerecha encabezados={encabezados} />
  </div>
</BaseLayout>

