---
interface Props {
  id: string;
  titulo?: string;
}

const { id, titulo } = Astro.props;
---

<dialog id={id} class="w-[min(48rem,calc(100vw-2rem))] rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--popover))] p-0 text-[hsl(var(--popover-foreground))] shadow-2xl backdrop:bg-black/60">
  {titulo && <header class="border-b border-[hsl(var(--border))] px-5 py-4 font-semibold">{titulo}</header>}
  <div class="p-5">
    <slot />
  </div>
</dialog>

