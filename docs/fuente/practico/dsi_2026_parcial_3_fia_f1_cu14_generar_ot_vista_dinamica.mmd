%% Documento origen: DSI 2026 Ejercicio tipo Parcial 3 FIA Formula 1.pdf
%% Caso de estudio: FIA F1
%% Tipo de diagrama: Diagrama de secuencia / Vista dinámica de realización de caso de uso de análisis
%% Caso de uso: CU 14 - Generar Orden de Traslado
%% Flujo: Creación de una Orden de Traslado por un Jefe Mecánico, con suficientes contenedores disponibles y notificación por email y SMS.
%% Fuente visual: páginas/hojas 8 y 9 de 15 del PDF.
%% Observación: se conserva el orden de mensajes de la captura y se representan los fragmentos loop principales de la vista dinámica.

sequenceDiagram
    autonumber

    actor GOT as ":Generador de Orden de Traslado"
    participant Pantalla as ":PantallaRegistrarOrdenTraslado"
    participant Gestor as ":GestorRegistrarOrdenTraslado"
    participant Sesion as ":Sesion"
    participant Usuario as "deLaSesion: Usuario"
    participant Logueado as "logueado: MiembroEquipo"
    participant Rol as ":Rol"
    participant Calendario as ":Calendario"
    participant CalendarioActual as "actual: Calendario"
    participant GP as ":GranPremio"
    participant Circuito as ":Circuito"
    participant Escuderia as ":Escuderia"
    participant Fabrica as ":Fabrica"
    participant EscuderiaLog as "delJMLogueado: Escuderia"
    participant Elemento as ":Elemento"
    participant TipoElemento as ":TipoElemento"
    participant Contenedor as ":Contenedor"
    participant Estado as ":Estado"
    participant MiembroEquipo as ":MiembroEquipo"
    participant JefeEquipo as "jefeEquipo: MiembroEquipo"
    participant InterfazMail as ":InterfazMail"
    participant InterfazSMS as ":InterfazSMS"
    participant OT as ":OrdenTraslado"
    participant CambioEstado as ":CambioEstado"
    participant DetalleOT as ":DetalleOT"

    GOT->>Pantalla: opcionGenerarOT()
    Pantalla->>Pantalla: habilitarVentana()
    Pantalla->>Gestor: generarOT()

    Gestor->>Gestor: validarRolUsuarioLogueado()
    Gestor->>Sesion: getUsuarioLogueado()
    Sesion-->>Gestor: deLaSesion
    Gestor->>Usuario: validarRolUsuarioLogueado()
    Usuario->>Logueado: esJefeDeEquipo()
    Logueado->>Rol: esJefeEquipo()
    Rol-->>Logueado: resultado
    Logueado-->>Usuario: resultado
    Usuario-->>Gestor: resultado

    Gestor->>Gestor: buscarCircuitosActivos()
    Gestor->>Gestor: getFechaHoraActual()
    Gestor->>Calendario: *esDeEsteAnio()
    Gestor->>CalendarioActual: buscarCircuitosActivos()
    CalendarioActual->>GP: *getNombreCircuito()
    GP->>Circuito: getNombre()
    Circuito-->>GP: nombre
    GP-->>CalendarioActual: nombreCircuito
    CalendarioActual-->>Gestor: circuitosActivos

    Gestor->>Gestor: buscarFabricaDeEscuderiaDelUsuarioLogueado()
    Gestor->>Escuderia: *esTuMecanico()
    Gestor->>EscuderiaLog: getFabricaEscuderia()
    EscuderiaLog->>Fabrica: getNombre()
    Fabrica-->>EscuderiaLog: nombre
    EscuderiaLog-->>Gestor: fabricaEscuderia

    Gestor->>Pantalla: mostrarFabricaYCircuitos()
    Gestor->>Pantalla: solicitarSeleccionOrigenYDestino()
    GOT->>Pantalla: tomarSeleccionOrigen()
    GOT->>Pantalla: tomarSeleccionDestino()
    Pantalla->>Gestor: tomarSeleccionOrigenYDestino()

    Gestor->>Gestor: buscarElementosDeEscuderia()
    Gestor->>EscuderiaLog: getElementos()
    loop Buscar elementos - mientras existan elementos
        EscuderiaLog->>Elemento: getCodigo()
        EscuderiaLog->>Elemento: getNombre()
        EscuderiaLog->>Elemento: getNombreTipo()
        Elemento->>TipoElemento: getNombre()
        TipoElemento-->>Elemento: nombreTipo
    end
    EscuderiaLog-->>Gestor: elementos

    Gestor->>Pantalla: solicitarSeleccionElementos()
    loop Selección de elementos - mientras el usuario seleccione elementos
        GOT->>Pantalla: tomarSeleccionElementos()
        Pantalla->>Gestor: tomarSeleccionElementos()
    end

    Gestor->>Gestor: agruparElementosPorTipoElemento()
    Gestor->>Gestor: calcularCantidadContenedoresNecesarios()
    Gestor->>Gestor: buscarContenedoresOciosos()
    Gestor->>EscuderiaLog: buscarContenedoresOciosos()
    loop Búsqueda de contenedores ociosos - mientras existan contenedores
        EscuderiaLog->>Contenedor: estaOcioso()
        Contenedor->>Estado: esOcioso()
        Estado-->>Contenedor: resultado
    end
    EscuderiaLog-->>Gestor: contenedoresOciosos

    Gestor->>Gestor: validarCantidadContenedoresOciosos()
    Gestor->>Gestor: asignarElementosAContenedor()
    Gestor->>Pantalla: solicitarSeleccionFechaLlegada()
    GOT->>Pantalla: tomarFechaLlegada()
    Pantalla->>Gestor: tomarFechaLlegada()
    Gestor->>Gestor: calcularUltimaFechaSalida()
    Gestor->>Gestor: validarFechaSalidaPosible()
    Gestor->>Pantalla: solicitarConfirmacion()

    GOT->>Pantalla: tomarConfirmacion()
    Pantalla->>Gestor: tomarConfirmacion()

    Gestor->>Gestor: generarOrdenTraslado()
    Gestor->>Gestor: buscarEstados()
    loop Buscar estados para OT - mientras haya estados
        Gestor->>Estado: esAmbitoOT()
        Gestor->>Estado: esCreada()
    end
    loop Buscar estados para contenedor - mientras haya estados
        Gestor->>Estado: esAmbitoContenedor()
        Gestor->>Estado: esAsignadoAOrden()
    end

    Gestor->>OT: new()
    Note right of OT: Se crea la Orden de Traslado en estado Creada.
    OT->>CambioEstado: crearCambioEstado()
    CambioEstado->>CambioEstado: new()
    OT->>OT: crearDetallesOT()

    loop Contenedores - mientras haya contenedores
        OT->>DetalleOT: new()
        DetalleOT->>Contenedor: asignarAOT()
    end

    Gestor->>Gestor: validarNotificaciones()
    Gestor->>EscuderiaLog: buscarJefeDeEquipo()
    loop Buscar Jefe de Equipo - mientras haya Miembros de Equipo
        EscuderiaLog->>MiembroEquipo: esJefeEquipo()
        MiembroEquipo->>Rol: esJefeEquipo()
        Rol-->>MiembroEquipo: resultado
    end
    EscuderiaLog-->>Gestor: jefeEquipo

    Gestor->>JefeEquipo: validarFormasNotificacion()
    Gestor->>JefeEquipo: getMail()
    JefeEquipo-->>Gestor: mail
    Gestor->>Gestor: enviarMail()
    Gestor->>InterfazMail: enviarNotificacion()

    Gestor->>JefeEquipo: getTelefono()
    JefeEquipo-->>Gestor: telefono
    Gestor->>Gestor: enviarSMS()
    Gestor->>InterfazSMS: enviarNotificacion()

    Gestor->>Gestor: finCU()
