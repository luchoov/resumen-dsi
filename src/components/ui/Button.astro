---
import { cn } from "@/lib/utils";

interface Props {
  as?: "button" | "a";
  href?: string;
  variant?: "default" | "outline" | "ghost";
  class?: string;
  type?: "button" | "submit" | "reset";
}

const { as = "button", href, variant = "default", class: className, type = "button" } = Astro.props as Props;
const classes = cn(
  "inline-flex min-h-10 items-center justify-center gap-2 rounded-lg px-4 py-2 text-sm font-medium transition-colors focus-visible:ring-2 focus-visible:ring-[hsl(var(--ring))]",
  variant === "default" && "bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] hover:bg-[hsl(var(--primary)/0.9)]",
  variant === "outline" && "border border-[hsl(var(--border))] bg-[hsl(var(--card))] text-[hsl(var(--foreground))] hover:bg-[hsl(var(--muted))]",
  variant === "ghost" && "text-[hsl(var(--foreground))] hover:bg-[hsl(var(--muted))]",
  className
);
---

{as === "a" ? <a href={href} class={classes}><slot /></a> : <button type={type} class={classes}><slot /></button>}
