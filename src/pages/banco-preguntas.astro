---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Topbar from "@/components/layout/Topbar.astro";
import { crearIndiceBusqueda, ordenarSecciones, seccionUrl } from "@/lib/secciones";
import { preguntas, categorias } from "@/lib/banco";

const secciones = ordenarSecciones(await getCollection("secciones"));
const indiceBusqueda = crearIndiceBusqueda(secciones);

// Metadatos de cada sección para el enlace "volver a la sección" del banco específico.
const seccionesInfo = Object.fromEntries(
  secciones.map((s) => [
    s.data.slug,
    { numero: s.data.numero, titulo: s.data.titulo, url: seccionUrl(s) }
  ])
);

const stripHtml = (s: string) => s.replace(/<[^>]+>/g, " ");
const normalize = (s: string) =>
  s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();
const items = preguntas.map((p) => ({
  ...p,
  texto: normalize(`${p.q} ${stripHtml(p.a)} ${p.c}`)
}));
---

<BaseLayout
  titulo="Banco de preguntas · Resumen DSI"
  descripcion="Banco de preguntas y respuestas de teoría y práctica de Diseño de Sistemas para repaso activo."
>
  <Topbar indiceBusqueda={indiceBusqueda} />
  <main class="mx-auto max-w-4xl px-4 pb-20 pt-24 lg:px-6">
    <header class="border-b border-[hsl(var(--border))] pb-7">
      <p class="mb-3 font-mono text-sm font-semibold uppercase tracking-[0.18em] text-[hsl(var(--primary))]">Repaso activo</p>
      <h1 class="max-w-3xl text-[length:var(--text-fluid-3xl)] font-bold leading-[1.05] tracking-[-0.02em]">Banco de preguntas</h1>
      <p class="mt-5 max-w-2xl text-[length:var(--text-fluid-lg)] text-[hsl(var(--muted-foreground))]">
        {preguntas.length} preguntas de teoría y práctica para autoevaluarte. Filtrá por tema o buscá, intentá responder y después abrí la respuesta.
      </p>
    </header>

    <!-- Banner que aparece cuando se llega desde una sección (?seccion=slug) -->
    <a
      id="qa-volver"
      href="#"
      hidden
      class="mt-6 flex items-center gap-3 rounded-xl border border-[hsl(var(--primary)/0.5)] bg-[hsl(var(--primary)/0.08)] px-4 py-3 text-sm no-print"
    >
      <svg class="h-5 w-5 shrink-0 text-[hsl(var(--primary))]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m12 19-7-7 7-7" /><path d="M19 12H5" /></svg>
      <span class="min-w-0 flex-1">
        Estás viendo las preguntas de <strong id="qa-volver-titulo" class="text-[hsl(var(--foreground))]"></strong>.
        <span class="text-[hsl(var(--muted-foreground))]">Volver a leer la sección.</span>
      </span>
    </a>

    <div class="sticky top-14 z-30 -mx-4 mb-6 border-b border-[hsl(var(--border))] bg-[hsl(var(--background)/0.9)] px-4 py-4 backdrop-blur-xl lg:-mx-6 lg:px-6 no-print">
      <input
        id="qa-search"
        type="search"
        placeholder="Buscar pregunta, término o concepto…"
        aria-label="Buscar preguntas"
        class="h-11 w-full rounded-lg border border-[hsl(var(--input))] bg-[hsl(var(--card))] px-4 text-base outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--ring))]"
      />
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <button type="button" data-cat="*" class="qa-chip rounded-full border border-[hsl(var(--primary)/0.6)] bg-[hsl(var(--primary)/0.12)] px-3 py-1 text-sm font-medium text-[hsl(var(--foreground))]">Todas</button>
        {categorias.map((cat) => (
          <button type="button" data-cat={cat} class="qa-chip rounded-full border border-[hsl(var(--border))] bg-[hsl(var(--card))] px-3 py-1 text-sm text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--muted))]">{cat}</button>
        ))}
        <span class="ml-auto flex items-center gap-3">
          <button type="button" id="qa-toggle-all" class="text-sm text-[hsl(var(--primary))] hover:underline">Expandir todo</button>
          <span id="qa-count" class="font-mono text-xs text-[hsl(var(--muted-foreground))]"></span>
        </span>
      </div>
    </div>

    <ol id="qa-list" class="space-y-3">
      {items.map((item, index) => (
        <li class="qa-item" data-cat={item.c} data-seccion={item.s} data-texto={item.texto}>
          <details class="group rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] transition-colors open:border-[hsl(var(--primary)/0.5)]">
            <summary class="flex cursor-pointer items-start gap-3 px-4 py-3.5 [&::-webkit-details-marker]:hidden">
              <span class="mt-0.5 font-mono text-xs text-[hsl(var(--muted-foreground))]">{String(index + 1).padStart(2, "0")}</span>
              <span class="min-w-0 flex-1">
                <span class="block font-semibold leading-snug">{item.q}</span>
                <span class="mt-1 inline-block rounded-md border border-[hsl(var(--border))] px-2 py-0.5 font-mono text-[0.7rem] text-[hsl(var(--muted-foreground))]">{item.c}</span>
              </span>
              <svg class="mt-1 h-5 w-5 shrink-0 text-[hsl(var(--muted-foreground))] transition-transform group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </summary>
            <div class="border-t border-[hsl(var(--border))] px-4 py-3.5 pl-11 text-[hsl(var(--foreground))]" set:html={item.a} />
          </details>
        </li>
      ))}
    </ol>

    <p id="qa-empty" class="hidden py-12 text-center text-[hsl(var(--muted-foreground))]">No hay preguntas que coincidan con el filtro.</p>
  </main>

  <script id="qa-secciones" type="application/json" set:html={JSON.stringify(seccionesInfo)} is:inline />
</BaseLayout>

<style>
  #qa-list :global(code) {
    border: 1px solid hsl(var(--border));
    border-radius: 0.375rem;
    background: hsl(var(--muted));
    padding: 0.05rem 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.85em;
  }

  #qa-list :global(strong) {
    color: hsl(var(--foreground));
    font-weight: 680;
  }
</style>

<script>
  type SeccionInfo = { numero: number; titulo: string; url: string };

  const initBancoPreguntas = () => {
    const list = document.getElementById("qa-list");
    if (!list) return; // only on this page
    const search = document.getElementById("qa-search") as HTMLInputElement | null;
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>(".qa-chip"));
    const items = Array.from(document.querySelectorAll<HTMLElement>(".qa-item"));
    const count = document.getElementById("qa-count");
    const empty = document.getElementById("qa-empty");
    const toggleAll = document.getElementById("qa-toggle-all");
    const volver = document.getElementById("qa-volver") as HTMLAnchorElement | null;
    const volverTitulo = document.getElementById("qa-volver-titulo");

    let secciones: Record<string, SeccionInfo> = {};
    try {
      secciones = JSON.parse(document.getElementById("qa-secciones")?.textContent ?? "{}");
    } catch {
      secciones = {};
    }

    let activeCat = "*";
    let activeSeccion = "";

    const normalize = (s: string) =>
      s.normalize("NFD").replace(/[̀-ͯ]/g, "").toLowerCase();

    const apply = () => {
      const query = normalize(search?.value ?? "");
      let visible = 0;
      items.forEach((item) => {
        const matchCat = activeCat === "*" || item.dataset.cat === activeCat;
        const matchSeccion = !activeSeccion || item.dataset.seccion === activeSeccion;
        const matchText = !query || (item.dataset.texto ?? "").includes(query);
        const show = matchCat && matchSeccion && matchText;
        item.hidden = !show;
        if (show) visible++;
      });
      if (count) count.textContent = `${visible} de ${items.length}`;
      if (empty) empty.classList.toggle("hidden", visible !== 0);
    };

    // Resalta el chip activo de categoría.
    const marcarChip = (cat: string) => {
      chips.forEach((c) => {
        const on = c.dataset.cat === cat;
        c.classList.toggle("border-[hsl(var(--primary)/0.6)]", on);
        c.classList.toggle("bg-[hsl(var(--primary)/0.12)]", on);
        c.classList.toggle("text-[hsl(var(--foreground))]", on);
        c.classList.toggle("border-[hsl(var(--border))]", !on);
        c.classList.toggle("bg-[hsl(var(--card))]", !on);
        c.classList.toggle("text-[hsl(var(--muted-foreground))]", !on);
      });
    };

    // Banco específico de una sección (llegada con ?seccion=slug).
    const aplicarSeccion = (slug: string) => {
      const info = secciones[slug];
      if (!info) return;
      activeSeccion = slug;
      activeCat = "*";
      marcarChip("*");
      if (volver && volverTitulo) {
        volver.href = info.url;
        volverTitulo.textContent = `la sección ${info.numero}: ${info.titulo}`;
        volver.hidden = false;
      }
      apply();
    };

    const limpiarSeccion = () => {
      activeSeccion = "";
      if (volver) volver.hidden = true;
    };

    chips.forEach((chip) => {
      chip.addEventListener("click", () => {
        activeCat = chip.dataset.cat ?? "*";
        limpiarSeccion();
        marcarChip(activeCat);
        apply();
      });
    });

    search?.addEventListener("input", apply);

    toggleAll?.addEventListener("click", () => {
      const details = items
        .filter((i) => !i.hidden)
        .map((i) => i.querySelector("details"))
        .filter(Boolean) as HTMLDetailsElement[];
      const anyClosed = details.some((d) => !d.open);
      details.forEach((d) => (d.open = anyClosed));
      toggleAll.textContent = anyClosed ? "Contraer todo" : "Expandir todo";
    });

    const params = new URLSearchParams(window.location.search);
    const seccionParam = params.get("seccion");
    const catParam = params.get("cat");
    if (seccionParam && secciones[seccionParam]) {
      aplicarSeccion(seccionParam);
    } else if (catParam) {
      activeCat = catParam;
      marcarChip(catParam);
      apply();
    } else {
      apply();
    }
  };

  document.addEventListener("astro:page-load", initBancoPreguntas);
</script>
