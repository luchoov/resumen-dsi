---
import type { Seccion } from "@/lib/secciones";
import { seccionUrl } from "@/lib/secciones";
import { ArrowLeft, ArrowRight } from "@lucide/astro";

interface Props {
  previa?: Seccion;
  siguiente?: Seccion;
}

const { previa, siguiente } = Astro.props;
---

<nav class="mt-14 grid gap-4 border-t border-[hsl(var(--border))] pt-6 sm:grid-cols-2 no-print" aria-label="Navegación entre secciones">
  {previa ? (
    <a href={seccionUrl(previa)} class="rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-4 hover:no-underline">
      <span class="mb-2 inline-flex items-center gap-2 text-sm text-[hsl(var(--muted-foreground))]"><ArrowLeft size={15} /> Anterior</span>
      <strong class="block text-[hsl(var(--foreground))]">{previa.data.titulo}</strong>
    </a>
  ) : <span />}
  {siguiente && (
    <a href={seccionUrl(siguiente)} class="rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--card))] p-4 text-right hover:no-underline">
      <span class="mb-2 inline-flex items-center justify-end gap-2 text-sm text-[hsl(var(--muted-foreground))]">Siguiente <ArrowRight size={15} /></span>
      <strong class="block text-[hsl(var(--foreground))]">{siguiente.data.titulo}</strong>
    </a>
  )}
</nav>

