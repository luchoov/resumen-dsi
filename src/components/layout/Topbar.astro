---
import { Menu, Moon, PanelLeftClose, PanelLeftOpen, Search, Sun } from "@lucide/astro";

interface Props {
  indiceBusqueda: Array<Record<string, string | number>>;
}

const { indiceBusqueda } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 border-b border-[hsl(var(--border))] bg-[hsl(var(--background)/0.86)] backdrop-blur-xl no-print">
  <div class="mx-auto flex h-14 max-w-[96rem] items-center gap-3 px-4 lg:px-6">
    <button id="abrir-sidebar" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[hsl(var(--border))] bg-[hsl(var(--card))] text-[hsl(var(--foreground))] lg:hidden" aria-label="Abrir índice">
      <Menu size={18} aria-hidden="true" />
    </button>
    <a href="/" class="flex min-w-0 items-baseline gap-2 text-[hsl(var(--foreground))] hover:no-underline">
      <span class="rounded-md bg-[hsl(var(--primary))] px-2 py-1 font-mono text-xs font-semibold text-[hsl(var(--primary-foreground))]">DSI</span>
      <span class="truncate text-sm font-semibold">Resumen Diseño de Sistemas</span>
    </a>
    <nav class="ml-4 hidden items-center gap-1 lg:flex" aria-label="Recursos">
      <a href="/banco-preguntas" class="rounded-lg px-3 py-1.5 text-sm text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--muted))] hover:text-[hsl(var(--foreground))] hover:no-underline">Banco de preguntas</a>
      <a href="/caso-creditin" class="rounded-lg px-3 py-1.5 text-sm text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--muted))] hover:text-[hsl(var(--foreground))] hover:no-underline">Caso CreditIn</a>
      <a href="/cheatsheet" class="rounded-lg px-3 py-1.5 text-sm text-[hsl(var(--muted-foreground))] hover:bg-[hsl(var(--muted))] hover:text-[hsl(var(--foreground))] hover:no-underline">Cheatsheet</a>
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <button id="abrir-busqueda" class="hidden h-10 min-w-[14rem] items-center justify-between rounded-lg border border-[hsl(var(--border))] bg-[hsl(var(--card))] px-3 text-sm text-[hsl(var(--muted-foreground))] md:flex" aria-label="Buscar en el resumen">
        <span class="inline-flex items-center gap-2"><Search size={16} aria-hidden="true" /> Buscar</span>
        <kbd class="rounded border border-[hsl(var(--border))] px-1.5 py-0.5 font-mono text-[0.7rem]">Ctrl K</kbd>
      </button>
      <button id="abrir-busqueda-mobile" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[hsl(var(--border))] bg-[hsl(var(--card))] md:hidden" aria-label="Buscar">
        <Search size={17} aria-hidden="true" />
      </button>
      <button id="toggle-indices" class="hidden h-10 w-10 items-center justify-center rounded-lg border border-[hsl(var(--border))] bg-[hsl(var(--card))] lg:inline-flex" aria-label="Mostrar u ocultar índices" title="Mostrar u ocultar índices">
        <PanelLeftClose class="block [.indices-hidden_&]:hidden" size={17} aria-hidden="true" />
        <PanelLeftOpen class="hidden [.indices-hidden_&]:block" size={17} aria-hidden="true" />
      </button>
      <button id="theme-toggle" class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-[hsl(var(--border))] bg-[hsl(var(--card))]" aria-label="Cambiar tema">
        <Sun class="theme-sun hidden dark:block" size={17} aria-hidden="true" />
        <Moon class="theme-moon block dark:hidden" size={17} aria-hidden="true" />
      </button>
    </div>
  </div>
  <script is:inline id="search-index" type="application/json" set:html={JSON.stringify(indiceBusqueda)} />
</header>

<dialog id="dialog-busqueda" class="w-[min(42rem,calc(100vw-2rem))] rounded-xl border border-[hsl(var(--border))] bg-[hsl(var(--popover))] p-0 text-[hsl(var(--popover-foreground))] shadow-2xl backdrop:bg-black/60">
  <form method="dialog" class="border-b border-[hsl(var(--border))] p-3">
    <label class="sr-only" for="input-busqueda">Buscar secciones</label>
    <input id="input-busqueda" class="h-12 w-full rounded-lg border border-[hsl(var(--input))] bg-[hsl(var(--background))] px-4 text-base outline-none focus-visible:ring-2 focus-visible:ring-[hsl(var(--ring))]" placeholder="Buscar por tema, patrón, diagrama..." autocomplete="off" />
  </form>
  <div id="resultados-busqueda" class="max-h-[60vh] overflow-y-auto p-2"></div>
</dialog>

<script>
  import Fuse from "fuse.js";

  type Entrada = { titulo: string; resumen: string; keywords: string; url: string; numero: number };

  let fuse: Fuse<Entrada> | null = null;
  let indice: Entrada[] = [];

  const applyTheme = (theme: string) => {
    document.documentElement.classList.toggle("dark", theme === "dark");
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
    window.dispatchEvent(new CustomEvent("themechange", { detail: { theme } }));
  };

  const renderResults = (query = "") => {
    const resultados = document.getElementById("resultados-busqueda");
    if (!resultados || !fuse) return;
    const items = query.trim() ? fuse.search(query).map((r) => r.item).slice(0, 8) : indice.slice(0, 8);
    resultados.innerHTML = items
      .map(
        (item) => `<a class="block rounded-lg px-3 py-2 hover:bg-[hsl(var(--muted))] focus-visible:bg-[hsl(var(--muted))]" href="${item.url}">
          <span class="font-mono text-xs text-[hsl(var(--primary))]">Sección ${item.numero}</span>
          <strong class="block text-sm text-[hsl(var(--foreground))]">${item.titulo}</strong>
          <span class="block text-sm text-[hsl(var(--muted-foreground))]">${item.resumen}</span>
        </a>`
      )
      .join("");
  };

  const openSearch = () => {
    const dialog = document.getElementById("dialog-busqueda") as HTMLDialogElement | null;
    const input = document.getElementById("input-busqueda") as HTMLInputElement | null;
    if (!dialog) return;
    renderResults();
    dialog.showModal();
    setTimeout(() => input?.focus(), 0);
  };

  let topbarController: AbortController | null = null;

  const initTopbarWhenReady = (callback: () => void) => {
    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", callback, { once: true });
      return;
    }

    callback();
  };

  // ClientRouter swaps the <body> on navigation, so re-bind listeners after each page load.
  const initTopbar = () => {
    topbarController?.abort();
    topbarController = new AbortController();
    const { signal } = topbarController;

    const rawIndex = document.getElementById("search-index")?.textContent ?? "[]";
    indice = JSON.parse(rawIndex) as Entrada[];
    fuse = new Fuse(indice, { keys: ["titulo", "resumen", "keywords"], threshold: 0.35, ignoreLocation: true });

    document.getElementById("theme-toggle")?.addEventListener("click", () => {
      applyTheme(document.documentElement.classList.contains("dark") ? "light" : "dark");
    }, { signal });
    document.getElementById("toggle-indices")?.addEventListener("click", () => {
      const hidden = document.documentElement.classList.toggle("indices-hidden");
      localStorage.setItem("indices", hidden ? "hidden" : "shown");
    }, { signal });
    document.getElementById("abrir-busqueda")?.addEventListener("click", openSearch, { signal });
    document.getElementById("abrir-busqueda-mobile")?.addEventListener("click", openSearch, { signal });
    document.getElementById("input-busqueda")?.addEventListener("input", (event) => {
      renderResults((event.target as HTMLInputElement).value);
    }, { signal });
    document.getElementById("resultados-busqueda")?.addEventListener("click", (event) => {
      if ((event.target as HTMLElement).closest("a")) {
        (document.getElementById("dialog-busqueda") as HTMLDialogElement | null)?.close();
      }
    }, { signal });
    document.getElementById("abrir-sidebar")?.addEventListener("click", () => {
      document.documentElement.classList.add("sidebar-open");
    }, { signal });
  };

  // window persists across view transitions, so bind the shortcut only once.
  const topbarWindow = window as Window & { __dsiSearchShortcutReady?: boolean };
  if (!topbarWindow.__dsiSearchShortcutReady) {
    topbarWindow.__dsiSearchShortcutReady = true;
    window.addEventListener("keydown", (event) => {
      if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        openSearch();
      }
    });
  }

  initTopbarWhenReady(initTopbar);
  document.addEventListener("astro:page-load", initTopbar);
</script>
